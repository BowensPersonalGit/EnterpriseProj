@using EnterpriseProj.Entities
@using EnterpriseProj.Messages
@model List<Appointment>

@{
    ViewData["Title"] = "Billing Dashboard";
}

<h2>Billing Dashboard</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Practictioner Name</th>
            <th>Speciality</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var appointment in Model)
        {
            <tr>
                <td>@appointment.Title</td>
                <td>@appointment.Description</td>
                <td>@appointment.StartTime</td>
                <td>@appointment.EndTime</td>
                <td>@appointment.Practitioner.Name</td>
                <td>@appointment.Practitioner.Job</td>
                <td>@appointment.Claim.Status.ToString()</td>
                <td>
                    @if (appointment.Claim.Status == ClaimStatus.NotStarted)
                    {
                        <button class="btn btn-primary"
                                onclick="startClaim(@appointment.Claim.Id)">
                            Start Claim
                        </button>
                    }
                    else if (appointment.Claim.Status == ClaimStatus.Started)
                    {
                        <button class="btn btn-success"
                                onclick="completeClaim(@appointment.Claim.Id)">
                            Complete Claim
                        </button>
                    }
                    else if (appointment.Claim.Status == ClaimStatus.Completed)
                    {
                        <span class="text-muted">Completed</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        //start claims process (mostly visual, for administrative purposes)
        // this is where the billing staff would say they started on a claim. Claiming the claim
        async function startClaim(id) {
            if (!confirm("Confirm that you are starting this claim")) return;

            try {
                const response = await fetch(`https://localhost:7202/api/BillingAPI/claims/update/${id}?newStatus=Started`, {
                    method: 'patch'
                });

                if (response.ok) {
                    alert("claim started. good luck.");
                    location.reload();
                } else {
                    const error = await response.text();
                    alert("could not change claim status: " + error);
                }
            } catch (err) {
                console.error(err);
                alert("failed to start claim.");
            }
        }

        //this will complete the claim process, and end any claim changes for the appointment
        async function completeClaim(id) {
            if (!confirm("Confirm that you are starting this claim")) return;

            try {
                const response = await fetch(`https://localhost:7202/api/BillingAPI/claims/update/${id}?newStatus=Completed`, {
                    method: 'patch'
                });

                if (response.ok) {
                    alert("claim completed.");
                    location.reload();
                } else {
                    const error = await response.text();
                    alert("could not change claim status: " + error);
                }
            } catch (err) {
                console.error(err);
                alert("failed to complete claim.");
            }
        }
    </script>
}