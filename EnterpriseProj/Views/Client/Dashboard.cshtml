@using EnterpriseProj.Entities;
@using EnterpriseProj.Messages;
@model List<AppointmentInfo>

@{
    ViewData["Title"] = "Client Dashboard";
}

<h2>Client Dashboard</h2>

<a class="btn btn-primary"
   asp-controller="Appointment"
   asp-action="Book">
    Book an Appointment
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Practictioner Name</th>
            <th>Speciality</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            <tr>
                <td>@app.Title</td>
                <td>@app.Description</td>
                <td>@app.StartTime</td>
                <td>@app.EndTime</td>
                <td>@app.PractitionerName</td>
                <td>@app.PractitionerJob</td>
                <td>
                    @if (app.isBooked) { <span>Booked</span> }
                    else { <span>Unbooked</span> }
                </td>
                <td>
                    @if (!app.IsPaid) { <button class="btn btn-primary" onclick="payForAppointment(@app.Id)">Pay</button> }
                    else { <p>Paid</p> }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        async function payForAppointment(appointmentId) {
            if (!confirm("Are you sure you want to proceed with payment?")) { return; }

            try {
                const response = await fetch(`/api/AppointmentAPI/pay/${appointmentId}`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    alert("Payment successful!");
                    location.reload(); // Refresh the page to reflect payment
                } else {
                    alert("Payment failed. Please try again.");
                }
            } catch (error) {
                console.error("Error during payment:", error);
                alert("An error occurred. Please try again.");
            }
        }
    </script>
}
