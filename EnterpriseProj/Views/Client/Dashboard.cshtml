@using EnterpriseProj.Entities;
@model List<Appointment>

@{
    ViewData["Title"] = "Client Dashboard";
}

<h2>Client Dashboard</h2>

<!-- Book an Appointment Button -->
<a class="btn btn-primary" asp-controller="Appointment" asp-action="Create">Book an Appointment</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Practitioner</th>
            <th>Booked</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            <tr>
                <td>@app.Title</td>
                <td>@app.Description</td>
                <td>@app.Practitioner.Name</td>
                <td>
                    @if (app.isBooked){ <t>Booked</t> }
                    else { <t>Unbooked</t> }
                </td>
                <td>
                    @if (!app.IsPaid) { <button class="btn btn-primary">Pay Now</button> }
                </td>
            </tr>
        }
    </tbody>
</table>
