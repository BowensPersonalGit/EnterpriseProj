@using EnterpriseProj.Entities
@model User
@{
    ViewData["Title"] = "Register";
    Layout = "_LayoutNoBanner";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
    <script src="~/js/register.js" asp-append-version="true"></script>
</head>
<body>
    <div class="container">
        <h2>Register</h2>

        <form asp-action="Register" method="post">
    <div>
        <label for="Name">Name:</label>
        <input asp-for="Name" id="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label for="Email">Email:</label>
        <input asp-for="Email" id="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label for="Password">Password:</label>
        <input asp-for="Password" id="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div>
        <label for="Role">Role:</label>
        <select asp-for="Role" asp-items="ViewBag.Roles" id="Role"></select>
        <span asp-validation-for="Role"></span>
    </div>

    <!-- Job Dropdown: Initially Hidden -->
    <div id="jobContainer" style="display:none;">
        <label for="JobId">Job:</label>
        <select asp-for="JobId" asp-items="ViewBag.Jobs" id="JobId"></select>
        <span asp-validation-for="JobId"></span>
    </div>

    <button type="submit">Register</button>
</form>


        <a class="back-link" asp-controller="Account" asp-action="Login">Back to login</a>
    </div>
</body>
</html>
