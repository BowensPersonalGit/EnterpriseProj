@using EnterpriseProj.Entities
@model User
@{
    ViewData["Title"] = "Register";
    Layout = "_LayoutNoBanner";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7fa;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .container {
            background-color: white;
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 400px;
        }
        h2 {
            text-align: center;
            color: #333;
        }
        form {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }
        label {
            font-size: 1rem;
            color: #555;
        }
        input, select {
            padding: 0.8rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 1rem;
        }
        input:focus, select:focus {
            outline: none;
            border-color: #0056b3;
        }
        button {
            background-color: #0056b3;
            color: white;
            border: none;
            padding: 0.8rem;
            border-radius: 4px;
            font-size: 1.1rem;
            cursor: pointer;
        }
        button:hover {
            background-color: #004b96;
        }
        .back-link {
            display: block;
            text-align: center;
            margin-top: 1rem;
            color: #0056b3;
        }
        .back-link:hover {
            text-decoration: underline;
        }
        span {
            color: red;
            font-size: 0.875rem;
        }
    </style>
</head>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const roleSelect = document.getElementById('Role');
        const jobContainer = document.getElementById('jobContainer');

        function toggleJobDropdown() {
            const selectedRole = roleSelect.options[roleSelect.selectedIndex].text.toLowerCase();
            if (selectedRole === 'practitioner') {
                jobContainer.style.display = 'block';
            } else {
                jobContainer.style.display = 'none';
            }
        }

        roleSelect.addEventListener('change', toggleJobDropdown);
        toggleJobDropdown(); // Run on page load
    });
</script>
<body>
    <div class="container">
        <h2>Register</h2>

        <form asp-action="Register" method="post">
    <div>
        <label for="Name">Name:</label>
        <input asp-for="Name" id="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label for="Email">Email:</label>
        <input asp-for="Email" id="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label for="Password">Password:</label>
        <input asp-for="Password" id="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div>
        <label for="Role">Role:</label>
        <select asp-for="Role" asp-items="ViewBag.Roles" id="Role"></select>
        <span asp-validation-for="Role"></span>
    </div>

    <!-- Job Dropdown: Initially Hidden -->
    <div id="jobContainer" style="display:none;">
        <label for="JobId">Job:</label>
        <select asp-for="JobId" asp-items="ViewBag.Jobs" id="JobId"></select>
        <span asp-validation-for="JobId"></span>
    </div>

    <button type="submit">Register</button>
</form>


        <a class="back-link" asp-controller="Account" asp-action="Login">Back to login</a>
    </div>
</body>
</html>
