@model EnterpriseProj.Messages.BookAppointment

@{
    ViewData["Title"] = "Client Book Appointment";
}

<h2>Book Appointment</h2>

<form asp-action="Book" asp-controller="Appointment" method="post">
    <div class="form-group">
        <label>Appointment</label>
        <select asp-for="AppointmentId" class="form-control">
            <option value="">Select Appointment</option>
            @if (ViewBag.Appointments is SelectList appointments)
            {
                foreach (var appointment in appointments)
                {
                    <option value="@appointment.Value">@appointment.Text</option>
                }
            }
        </select>
    </div>

    <div class="form-group">
        <label>Title</label>
        <input asp-for="Title" class="form-control" required/>
    </div>

    <div class="form-group">
        <label>Description</label>
        <input asp-for="Description" class="form-control" required/>
    </div>

    <input type="hidden" asp-for="ClientId" />

    <button type="submit" class="btn btn-primary">Confirm Booking</button>
</form>
