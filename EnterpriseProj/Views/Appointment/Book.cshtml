@model EnterpriseProj.Messages.BookAppointment

@{
    ViewData["Title"] = "Book Appointment";
    bool isClient = ViewBag.IsClient != null && (bool)ViewBag.IsClient;
    var appointmentId = ViewBag.AppointmentId as int?;
}

<h2>Book Appointment</h2>

<form asp-action="Book" asp-controller="Appointment" method="post">
    <div class="form-group">
        <label>Appointment</label>
        <select asp-for="AppointmentId" class="form-control" id="appointmentDropdown">
            <option value="">Select Appointment</option>
            @if (ViewBag.Appointments is SelectList appointments)
            {
                foreach (var appointment in appointments)
                {
                    <option value="@appointment.Value" selected="@(appointment.Value == appointmentId?.ToString())">
                        @appointment.Text
                    </option>
                }
            }
        </select>
    </div>

    <div class="form-group">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="form-group">
        <label>Description</label>
        <input asp-for="Description" class="form-control" />
    </div>

    @if (isClient)
    {
        <input type="hidden" asp-for="ClientId" value="@ViewBag.ClientId" />
    }
    else if (ViewBag.Clients is SelectList clients)
    {
        <div class="form-group">
            <label>Select Client</label>
            <select asp-for="ClientId" class="form-control">
                @foreach (var client in clients)
                {
                    <option value="@client.Value">@client.Text</option>
                }
            </select>
        </div>
    }

    <button type="submit" class="btn btn-primary">Confirm Booking</button>
</form>

@section Scripts {
    <script>
        document.getElementById("appointmentDropdown").addEventListener("change", function () {
            const selectedId = this.value;
            if (selectedId) {
                window.location.href = `/Appointment/Book?appointmentId=${selectedId}`;
            }
        });
    </script>
}

<script>
    document.getElementById("Book")?.addEventListener("submit", async function (e) {
        e.preventDefault();

        const id = document.getElementById("AppointmentId").value;

        const data = {
            title: document.getElementById("Title").value,
            description: document.getElementById("Description").value,
            clientId: parseInt(document.getElementById("ClientId").value)
        };

        const response = await fetch(`/AppointmentAPI/book/${id}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            alert("Appointment booked!");
            window.location.href = "/Billing/Dashboard";
        } else {
            const err = await response.text();
            alert("Error: " + err);
        }
    });
</script>
