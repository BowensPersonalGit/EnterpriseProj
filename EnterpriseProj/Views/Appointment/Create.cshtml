@model EnterpriseProj.Messages.NewAppointment

@{
    ViewData["Title"] = "Create Appointment";
}

<h2>Create Appointment</h2>

<form id="Create" asp-action="Create" method="post">
    <div class="form-group">
        <label>Title</label>
        <input class="form-control" id="Title" asp-for="Title" />
    </div>
    <div class="form-group">
        <label>Description</label>
        <input class="form-control" id="Description" asp-for="Description" />
    </div>
    <div class="form-group">
        <label>Start Time</label>
        <input type="datetime-local" class="form-control" id="StartTime" asp-for="StartTime" />
    </div>
    <div class="form-group">
        <label>End Time</label>
        <input type="datetime-local" class="form-control" id="EndTime" asp-for="EndTime" />
    </div>
    <div class="form-group">
        <label>Practitioner</label>
        <select class="form-control" id="PractitionerId" name="PracticionerId" required>
            <option value="">--</option>
        </select>
    </div>

    <input type="hidden" id="ClientId" name="ClientId" value="2" />

    <button type="submit" class="btn btn-primary">Create Appointment</button>
</form>

<script>
    //function to load all practitioners into the dropdown
    async function loadPractitioners() {
        try {
            const response = await fetch(`https://localhost:7202/api/AppointmentAPI/practitioners`);
            if (!response.ok) { throw new Error(`failed to fetch practitioners: ${response.status}`); }
            const data = await response.json();
            const practitionerSelect = document.getElementById('PractitionerId');
            data.users.forEach(user => {
                const option = document.createElement('option');
                option.value = user.userId;
                option.textContent = user.userName;
                practitionerSelect.appendChild(option);
            });
        } catch (err) {
            console.error('error loading practitioners:', err);
        }
    }

    document.getElementById("Create").addEventListener("submit", async function (e) {
        e.preventDefault();

        const data = {
            dto: {
                title: document.getElementById("Title").value,
                description: document.getElementById("Description").value,
                startTime: document.getElementById("StartTime").value,
                endTime: document.getElementById("EndTime").value,
                practitionerId: parseInt(document.getElementById("PractitionerId").value),
                clientId: parseInt(document.getElementById("ClientId").value)
            }
        };

        console.log("Posting data:", JSON.stringify(data));

        const response = await fetch('https://localhost:7202/api/AppointmentAPI/create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            alert("Appointment created!");
            window.location.href = "https://localhost:7202/Practitioner/Dashboard"; // or wherever you want
        } else {
            const err = await response.text();
            alert("Error: " + err);
        }
    });

    loadPractitioners();
</script>