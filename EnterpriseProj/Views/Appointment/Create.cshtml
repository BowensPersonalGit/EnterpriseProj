@model EnterpriseProj.Messages.NewAppointment

@{
    ViewData["Title"] = "Create Appointment";
}

<h2>Create Appointment</h2>

<form id="Create" asp-action="Create" method="post">
    <div class="form-group">
        <label>Title</label>
        <input class="form-control" id="Title" asp-for="Title" required />
    </div>
    <div class="form-group">
        <label>Description</label>
        <input class="form-control" id="Description" asp-for="Description" />
    </div>
    <div class="form-group">
        <label>Start Time</label>
        <input type="datetime-local" class="form-control" id="StartTime" asp-for="StartTime" required />
    </div>
    <div class="form-group">
        <label>End Time</label>
        <input type="datetime-local" class="form-control" id="EndTime" asp-for="EndTime" required />
    </div>
    
    <input type="hidden" id="PractitionerId" name="PractitionerId" value="@ViewBag.PractitionerId" />

    <button type="submit" class="btn btn-primary">Create Appointment</button>
</form>